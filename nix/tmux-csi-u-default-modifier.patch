Accept CSI-u keys with an omitted modifier parameter as unmodified keys.
Only the bare-number form is new; semicolon forms still use the existing parser.
Use strtonum rather than a partial sscanf match so empty or overflowing bare
numbers cannot become valid keys.

--- a/tty-keys.c
+++ b/tty-keys.c
@@ -1039,5 +1039,6 @@ tty_keys_extended_key(struct tty *tty, const char *buf, size_t len,
 {
 	struct client	*c = tty->client;
+	const char	*errstr;
 	size_t		 end;
 	u_int		 number, modifiers;
 	char		 tmp[64];
@@ -1081,6 +1082,11 @@ tty_keys_extended_key(struct tty *tty, const char *buf, size_t len,
 	if (buf[end] == '~') {
 		if (sscanf(tmp, "27;%u;%u", &modifiers, &number) != 2)
 			return (-1);
+	} else if (strchr(tmp, ';') == NULL) {
+		number = strtonum(tmp, 0, UINT_MAX, &errstr);
+		if (errstr != NULL)
+			return (-1);
+		modifiers = 1;
 	} else {
 		if (sscanf(tmp ,"%u;%u", &number, &modifiers) != 2)
 			return (-1);
