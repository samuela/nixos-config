drm/ttm: v2 fix for the bulk_move dangling-cursor UAF (#5387)

For on-metal validation on linux-7.0.11. Removes a resource from its
bulk_move cursor at the unevictable transition (in ttm_resource_move_to_lru_tail
and the v7.0.11-only ttm_resource_del_bulk_move_unevictable), tracked by a new
ttm_resource::bulk_move flag, so the cursor is never left referencing a
resource whose LRU link has moved to bdev->unevictable. No diagnostic noise --
KASAN/DEBUG_LIST staying silent under load is the pass criterion.

diff --git a/drivers/gpu/drm/ttm/ttm_resource.c b/drivers/gpu/drm/ttm/ttm_resource.c
index bfd9c68..bfdca07 100644
--- a/drivers/gpu/drm/ttm/ttm_resource.c
+++ b/drivers/gpu/drm/ttm/ttm_resource.c
@@ -280,16 +280,20 @@ static bool ttm_resource_unevictable(struct ttm_resource *res, struct ttm_buffer
 void ttm_resource_add_bulk_move(struct ttm_resource *res,
 				struct ttm_buffer_object *bo)
 {
-	if (bo->bulk_move && !ttm_resource_unevictable(res, bo))
+	if (bo->bulk_move && !ttm_resource_unevictable(res, bo)) {
 		ttm_lru_bulk_move_add(bo->bulk_move, res);
+		res->bulk_move = true;
+	}
 }
 
-/* Remove the resource from a bulk move if the BO is configured for it */
+/* Remove the resource from a bulk move if it is tracked by one */
 void ttm_resource_del_bulk_move(struct ttm_resource *res,
 				struct ttm_buffer_object *bo)
 {
-	if (bo->bulk_move && !ttm_resource_unevictable(res, bo))
+	if (res->bulk_move) {
 		ttm_lru_bulk_move_del(bo->bulk_move, res);
+		res->bulk_move = false;
+	}
 }
 
 /*
@@ -301,8 +305,10 @@ void ttm_resource_del_bulk_move_unevictable(struct ttm_resource *res,
 					    struct ttm_buffer_object *bo)
 {
 	WARN_ON_ONCE(!ttm_resource_unevictable(res, bo));
-	if (bo->bulk_move)
+	if (res->bulk_move) {
 		ttm_lru_bulk_move_del(bo->bulk_move, res);
+		res->bulk_move = false;
+	}
 }
 
 /* Move a resource to the LRU or bulk tail */
@@ -314,9 +320,21 @@ void ttm_resource_move_to_lru_tail(struct ttm_resource *res)
 	lockdep_assert_held(&bo->bdev->lru_lock);
 
 	if (ttm_resource_unevictable(res, bo)) {
+		/*
+		 * The resource is leaving the manager LRU for the unevictable
+		 * list. If it is still tracked by a bulk_move cursor, take it off
+		 * now, while its link is still on the manager LRU so the cursor
+		 * update can walk it. Otherwise pos->first/last would be left
+		 * referencing a resource whose link is no longer in the range,
+		 * which ttm_lru_bulk_move_tail() then dereferences.
+		 */
+		if (res->bulk_move) {
+			ttm_lru_bulk_move_del(bo->bulk_move, res);
+			res->bulk_move = false;
+		}
 		list_move_tail(&res->lru.link, &bdev->unevictable);
 
-	} else if (bo->bulk_move) {
+	} else if (res->bulk_move) {
 		struct ttm_lru_bulk_move_pos *pos =
 			ttm_lru_bulk_move_pos(bo->bulk_move, res);
 
@@ -352,6 +370,7 @@ void ttm_resource_init(struct ttm_buffer_object *bo,
 	res->bus.is_iomem = false;
 	res->bus.caching = ttm_cached;
 	res->bo = bo;
+	res->bulk_move = false;
 
 	man = ttm_manager_type(bo->bdev, place->mem_type);
 	spin_lock(&bo->bdev->lru_lock);
diff --git a/include/drm/ttm/ttm_resource.h b/include/drm/ttm/ttm_resource.h
index a5d3865..7b4d642 100644
--- a/include/drm/ttm/ttm_resource.h
+++ b/include/drm/ttm/ttm_resource.h
@@ -274,6 +274,14 @@ struct ttm_resource {
 	 * @lru: Least recently used list, see &ttm_resource_manager.lru
 	 */
 	struct ttm_lru_item lru;
+
+	/**
+	 * @bulk_move: Whether this resource is currently tracked by its bo's
+	 * &ttm_buffer_object.bulk_move cursor. Recorded on add so the resource
+	 * is taken off the cursor on every removal path -- including when it
+	 * becomes unevictable -- before its &lru link leaves the manager LRU.
+	 */
+	bool bulk_move;
 };
 
