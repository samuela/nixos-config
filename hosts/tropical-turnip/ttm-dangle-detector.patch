+				  "TTM#5387: move_to_lru_tail leaves resource %p on bulk_move cursor (first=%p last=%p)\n",
+				  res, pos->first, pos->last);
+		}
 		list_move_tail(&res->lru.link, &bdev->unevictable);
 
