drm/ttm: DEBUG-ONLY detector for the bulk_move dangling-cursor bug (#5387)

Not for upstream. Adds WARN_ONCE() probes that fire the moment a resource still
referenced by a bulk_move cursor (pos->first / pos->last) leaves the cursor's
tracked list without the cursor being updated -- the exact precondition that
later detonates as a use-after-free in ttm_resource_add_bulk_move(). Lets us
confirm on-metal whether the hibernation/swapout path plants the dangling
cursor, without waiting for the rare allocation that reads it. Does not change
behaviour (still buggy, just loud).

--- a/drivers/gpu/drm/ttm/ttm_resource.c
+++ b/drivers/gpu/drm/ttm/ttm_resource.c
@@ -288,8 +288,18 @@
 void ttm_resource_del_bulk_move(struct ttm_resource *res,
 				struct ttm_buffer_object *bo)
 {
-	if (bo->bulk_move && !ttm_resource_unevictable(res, bo))
+	if (bo->bulk_move && !ttm_resource_unevictable(res, bo)) {
 		ttm_lru_bulk_move_del(bo->bulk_move, res);
+	} else if (bo->bulk_move) {
+		struct ttm_lru_bulk_move_pos *pos =
+			ttm_lru_bulk_move_pos(bo->bulk_move, res);
+
+		/* DEBUG #5387: del skipped for an unevictable resource that the
+		 * cursor still points at -> cursor will dangle once freed. */
+		WARN_ONCE(pos->first == res || pos->last == res,
+			  "TTM#5387: del skipped for unevictable resource %p still on bulk_move cursor (first=%p last=%p)\n",
+			  res, pos->first, pos->last);
+	}
 }
 
 /*
@@ -314,6 +324,16 @@
 	lockdep_assert_held(&bo->bdev->lru_lock);
 
 	if (ttm_resource_unevictable(res, bo)) {
+		if (bo->bulk_move) {
+			struct ttm_lru_bulk_move_pos *pos =
+				ttm_lru_bulk_move_pos(bo->bulk_move, res);
+
+			/* DEBUG #5387: moving a cursor-tracked resource to the
+			 * unevictable list without updating the cursor. */
